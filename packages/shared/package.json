{
  "name": "@ecommerce/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, enums, constants and Zod schemas",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "import": "./dist/enums/index.mjs",
      "require": "./dist/enums/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/enums/index.ts src/types/index.ts src/schemas/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/enums/index.ts src/types/index.ts src/schemas/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint src/**/*.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ecommerce/eslint-config": "workspace:*",
    "@ecommerce/tsconfig": "workspace:*",
    "eslint": "^9.20.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
