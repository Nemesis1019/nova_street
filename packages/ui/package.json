{
  "name": "@ecommerce/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Mantine UI preset and theme tokens",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/theme/index.ts --format cjs,esm --dts --clean --external react react-dom @mantine/core @mantine/hooks",
    "dev": "tsup src/index.ts src/theme/index.ts --format cjs,esm --dts --watch --external react react-dom @mantine/core @mantine/hooks",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint src/**/*.ts",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ecommerce/eslint-config": "workspace:*",
    "@ecommerce/tsconfig": "workspace:*",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "eslint": "^9.20.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
