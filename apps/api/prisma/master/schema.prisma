// Esquema de la BASE MAESTRA de la plataforma (SaaS multi-tenant).
// Registra los clientes (tenants), sus dominios y la conexión a la BD de cada uno.
// Las migraciones de este esquema viven en `prisma/master/migrations` (separadas
// de las migraciones de las BDs de cada tienda en `prisma/migrations`).

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

/// Estado comercial del cliente dentro de la plataforma. Es independiente de
/// `TenantStatus` (que controla el acceso operativo a la tienda).
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
}

/// Catálogo de planes SaaS. El precio y el período se snapshotean en cada
/// intento de pago para que un cambio de plan no altere el historial.
model SubscriptionPlan {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  amount      Int
  currency    String  @default("COP")
  periodDays  Int     @default(30)
  features    Json?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants  Tenant[]
  payments SubscriptionPayment[]

  @@map("subscription_plans")
}

/// Identidad de la plataforma, separada de los tenants.
enum PlatformRole {
  OWNER
  OPERATOR
  SUPPORT
}

model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String

  status TenantStatus @default(ACTIVE)

  /// URL de conexión a la BD del cliente, cifrada (AES-256-GCM).
  databaseUrl String

  /// Cliente por defecto (se usa cuando no se puede resolver el tenant por host/header).
  isDefault Boolean @default(false)

  /// Estado de la suscripción SaaS y vigencia del último pago confirmado.
  subscriptionStatus       SubscriptionStatus @default(TRIAL)
  subscriptionPaidUntil    DateTime?
  subscriptionLastPaymentAt       DateTime?
  subscriptionLastPaymentAmount   Int?
  subscriptionLastPaymentCurrency String?
  subscriptionSuspendedAt         DateTime?

  /// Plan comercial vigente. Al pagar se actualiza desde el snapshot del pago.
  subscriptionPlanId String?           @db.Uuid
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)

  /// Último error de provisioning (si falló el alta del cliente).
  provisioningError String?

  /// Overrides de storage por cliente. Si están vacíos se usa el bucket de la
  /// plataforma (env `R2_*`) con prefijo `t/<slug>/`.
  r2Bucket          String?
  r2Endpoint        String?
  r2AccessKeyId     String?
  r2SecretAccessKey String?
  r2PublicUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains              TenantDomain[]
  migrations           TenantMigration[]
  subscriptionPayments SubscriptionPayment[]

  @@map("tenants")
}

/// Intentos de pago de la suscripción SaaS. El pago se confirma sólo con el
/// webhook firmado de Bold; nunca con el redirect del navegador.
model SubscriptionPayment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Referencia enviada a Bold y devuelta en `metadata.reference`.
  reference String @unique

  amount      Int
  currency    String @default("COP")
  periodDays  Int    @default(30)
  status      SubscriptionPaymentStatus @default(PENDING)
  provider    String @default("bold")

  /// Snapshot del plan al iniciar el checkout.
  planId   String?           @db.Uuid
  plan     SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName String?

  providerTransactionId String?
  paidAt                DateTime?
  metadata              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@map("subscription_payments")
}

/// Historial de migraciones/ejecuciones por cliente (panel de plataforma).
model TenantMigration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nombre de la última migración aplicada (o "provisioning"/"migrate deploy").
  name   String
  status String @default("APPLIED")
  error  String?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_migrations")
}

model TenantDomain {
  id       String @id @default(uuid()) @db.Uuid
  host     String @unique
  isPrimary Boolean @default(false)

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("tenant_domains")
}

model PlatformUser {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  role         PlatformRole @default(OPERATOR)
  isActive     Boolean      @default(true)

  /// TOTP cifrado (AES-256-GCM con PLATFORM_SECRET).
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions PlatformSession[]
  audits   PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformSession {
  id               String @id @default(uuid()) @db.Uuid
  platformUserId   String @db.Uuid
  platformUser     PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([platformUserId])
  @@map("platform_sessions")
}

model PlatformAuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  platformUserId String? @db.Uuid
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  action   String
  entity   String?
  entityId String?
  metadata Json?
  ip       String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([platformUserId])
  @@map("platform_audit_logs")
}
