// Esquema de la BASE MAESTRA de la plataforma (SaaS multi-tenant).
// Registra los clientes (tenants), sus dominios y la conexión a la BD de cada uno.
// Las migraciones de este esquema viven en `prisma/master/migrations` (separadas
// de las migraciones de las BDs de cada tienda en `prisma/migrations`).

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

/// Identidad de la plataforma, separada de los tenants.
enum PlatformRole {
  OWNER
  OPERATOR
  SUPPORT
}

model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String

  status TenantStatus @default(ACTIVE)

  /// URL de conexión a la BD del cliente, cifrada (AES-256-GCM).
  databaseUrl String

  /// Cliente por defecto (se usa cuando no se puede resolver el tenant por host/header).
  isDefault Boolean @default(false)

  /// Último error de provisioning (si falló el alta del cliente).
  provisioningError String?

  /// Overrides de storage por cliente. Si están vacíos se usa el bucket de la
  /// plataforma (env `R2_*`) con prefijo `t/<slug>/`.
  r2Bucket          String?
  r2Endpoint        String?
  r2AccessKeyId     String?
  r2SecretAccessKey String?
  r2PublicUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains    TenantDomain[]
  migrations TenantMigration[]

  @@map("tenants")
}

/// Historial de migraciones/ejecuciones por cliente (panel de plataforma).
model TenantMigration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nombre de la última migración aplicada (o "provisioning"/"migrate deploy").
  name   String
  status String @default("APPLIED")
  error  String?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_migrations")
}

model TenantDomain {
  id       String @id @default(uuid()) @db.Uuid
  host     String @unique
  isPrimary Boolean @default(false)

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("tenant_domains")
}

model PlatformUser {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  role         PlatformRole @default(OPERATOR)
  isActive     Boolean      @default(true)

  /// TOTP cifrado (AES-256-GCM con PLATFORM_SECRET).
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions PlatformSession[]
  audits   PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformSession {
  id               String @id @default(uuid()) @db.Uuid
  platformUserId   String @db.Uuid
  platformUser     PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([platformUserId])
  @@map("platform_sessions")
}

model PlatformAuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  platformUserId String? @db.Uuid
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  action   String
  entity   String?
  entityId String?
  metadata Json?
  ip       String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([platformUserId])
  @@map("platform_audit_logs")
}
