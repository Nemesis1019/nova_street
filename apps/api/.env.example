# ============================================================
# 1. GENERAL
# ============================================================
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Comma-separated list of frontend URLs allowed by CORS
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Store name used in emails
STORE_NAME=NÖVA

# ============================================================
# 2. DATABASE
# ============================================================
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5433/ecommerce?schema=public

# ============================================================
# 3. REDIS (cache + queues)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# 4. JWT (replace with strong random values in production)
# ============================================================
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================================
# 5. EMAIL
#    EMAIL_PROVIDER=smtp | resend
# ============================================================
EMAIL_PROVIDER=smtp

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=change-me-smtp-password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ============================================================
# 6. PAYMENTS
#    PAYMENT_PROVIDER=stripe
# ============================================================
PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_SUCCESS_URL=http://localhost:3000/orders?paid=success
STRIPE_CANCEL_URL=http://localhost:3000/catalogo

# ============================================================
# 7. STORAGE (Cloudflare R2 / S3-compatible)
#    Get these values from your Cloudflare R2 dashboard.
# ============================================================
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET=ecommerce-catalog-dev
R2_PUBLIC_URL=https://<your-public-domain>.com

# Optional: override the public URL for all assets (CDN)
# CDN_BASE_URL=https://cdn.example.com

# Presigned upload settings
PRESIGN_URL_EXPIRATION_SECONDS=300
PRESIGN_MAX_FILE_SIZE_BYTES=10485760

# ============================================================
# 8. BACKUPS
# ============================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
