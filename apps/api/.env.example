# ============================================================
# 1. GENERAL
# ============================================================
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Comma-separated list of frontend URLs allowed by CORS
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Store name used in emails
STORE_NAME=NÖVA

# ============================================================
# 2. DATABASE
# ============================================================
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5433/ecommerce?schema=public

# ============================================================
# 3. REDIS (cache + queues)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# 4. JWT (replace with strong random values in production)
# ============================================================
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================================
# 5. EMAIL
#    EMAIL_PROVIDER=smtp | resend
# ============================================================
EMAIL_PROVIDER=smtp

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=change-me-smtp-password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ============================================================
# 6. PAYMENTS
#    PAYMENT_PROVIDER=stripe
# ============================================================
PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_SUCCESS_URL=http://localhost:3000/orders?paid=success
STRIPE_CANCEL_URL=http://localhost:3000/catalogo

# Bold (Colombia) — botón de pagos / link de pagos
# Las llaves también se pueden configurar desde /store-config (tienen prioridad).
# BOLD_API_KEY=llave_de_identidad
# BOLD_SECRET_KEY=llave_secreta
# BOLD_SANDBOX=true
# URL pública del storefront (redirección tras el pago y callback de Bold)
# STOREFRONT_URL=http://localhost:3000

# ============================================================
# 7. STORAGE (Cloudflare R2 / S3-compatible)
#    Get these values from your Cloudflare R2 dashboard.
# ============================================================
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET=ecommerce-catalog-dev
R2_PUBLIC_URL=https://<your-public-domain>.com

# Optional: override the public URL for all assets (CDN)
# CDN_BASE_URL=https://cdn.example.com

# Presigned upload settings
PRESIGN_URL_EXPIRATION_SECONDS=300
PRESIGN_MAX_FILE_SIZE_BYTES=10485760

# ============================================================
# 8. BACKUPS
# Nota: las credenciales de pago/email de cada cliente se configuran en
# StoreConfig (admin → Configuración de la tienda); estas envs son el fallback
# de la plataforma para clientes que no definieron las suyas.
# ============================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Si el host no tiene pg_dump (dev con Postgres en Docker), indicar el contenedor:
# BACKUP_DOCKER_CONTAINER=ecommerce-postgres
# Backups programados de todos los clientes (por defecto solo en producción):
# BACKUP_SCHEDULER_ENABLED=true
# BACKUP_INTERVAL_HOURS=24

# 9. PLATAFORMA
# Minutos de vigencia de una sesión impersonada desde el panel de plataforma:
IMPERSONATION_TTL_MINUTES=120
# Máximo de clientes Prisma por tenant cacheados por instancia (LRU):
TENANT_PRISMA_MAX_CLIENTS=50
# Cuentas de plataforma (legacy = SUPER_ADMIN del tenant por defecto). En
# producción dejar en false y usar PlatformUser.
# ALLOW_LEGACY_PLATFORM_ADMIN=false
# PLATFORM_ACCESS_EXPIRATION=15m
# PLATFORM_REFRESH_EXPIRATION=7d
# Rotación de PLATFORM_SECRET (descifra valores viejos durante la migración):
# PLATFORM_SECRET_PREVIOUS=

# ============================================================
# 9. SAAS MULTI-TENANT (BD por cliente)
# ============================================================
# Base de datos maestra con los clientes, dominios y conexiones cifradas.
MASTER_DATABASE_URL=postgresql://ecommerce:password@localhost:5433/nova_master?schema=public
# Cliente por defecto (se usa en localhost / cuando no se resuelve el subdominio).
DEFAULT_TENANT_SLUG=nova
# Clave para cifrar secretos de plataforma (URL de BD de cada cliente, etc.).
# En producción usar un valor aleatorio de 32+ bytes.
PLATFORM_SECRET=change-me
